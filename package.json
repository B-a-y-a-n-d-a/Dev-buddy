{
  "name": "dev-buddy",
  "version": "1.0.0",
  "description": "Error Oracle - multi-agent AI stack trace diagnosis tool built with Google ADK TypeScript + Gemini",
  "main": "agent.js",
  "scripts": {
    "dev": "npx adk web agent.js --allow_origins=http://localhost:3000 --compile=false --bundle=false",
    "ui": "node proxy.js",
    "run-cli": "npx adk run agent.js --compile=false --bundle=false"
  },
  "dependencies": {
    "@google/adk": "latest"
  },
  "devDependencies": {
    "@google/adk-devtools": "latest",
    "typescript": "^5.0.0",
    "@types/node": "^20.0.0"
  },
  "type": "module"
}
